{
  "name": "@kaname/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "type-check": "tsc --noEmit",
    "e2e": "playwright test",
    "build:test": "NEXT_DIST_DIR=.next-prod next build",
    "start:test": "NEXT_DIST_DIR=.next-prod next start --port 3124",
    "e2e:screens": "PW_REPORT=pw-reports/screens.json BASE_URL=http://127.0.0.1:3124 playwright test tests/screens tests/shared.spec.ts tests/reachability.spec.ts tests/layout.spec.ts",
    "e2e:showcase": "PW_REPORT=pw-reports/showcase.json BASE_URL=http://localhost:3123 playwright test tests/shell.spec.ts tests/shell-ops.spec.ts tests/ui.spec.ts tests/views.spec.ts",
    "e2e:bridge": "PW_REPORT=pw-reports/bridge-loop.json BASE_URL=http://127.0.0.1:3124 playwright test tests/screens/bridge-loop.spec.ts tests/screens/setup-gate.spec.ts --retries=2",
    "e2e:k": "PW_REPORT=pw-reports/k.json playwright test tests/components.spec.ts tests/k-shell.spec.ts tests/states.spec.ts tests/k tests/features"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.7.15",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@kaname/config": "workspace:*",
    "@kaname/contracts": "workspace:*",
    "@kaname/errors": "workspace:*",
    "@simplewebauthn/browser": "13.3.0",
    "@svar-ui/react-gantt": "^2.7.3",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-subscript": "3.32.2",
    "@tiptap/extension-superscript": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "mermaid": "^12.0.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "temml": "^0.13.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
