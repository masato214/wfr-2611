# 正本（G13 ci:env-audit が packages/config の読む名前と突き合わせる）。値は例。秘密は Infisical の環境から入れる（この例の値を本番で使わない）
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
# 画面の URL（メールのリンクの先）。ローカルは next dev
WEB_BASE_URL=http://localhost:3123
# DB（関門 C2）。管理者の接続は migration だけに使う。実行時は kaname_app
DATABASE_URL=postgres://kaname_app:kaname_app@127.0.0.1:55433/kaname_dev
# 会話が変わった知らせを受ける接続（D-113）。API 1 台につき 1 本だけ持つ。LISTEN が効く直の接続か Session pooler（5432）を書く。
# Transaction pooler（6543）は不可。空なら画面は今までどおり 1.2 秒ごとに見に行く
DATABASE_LISTEN_URL=postgres://kaname_app:kaname_app@127.0.0.1:55433/kaname_dev
# migration だけが使う管理者の接続（staging／本番。ローカルは無くてよい＝DATABASE_URL を使う）
DATABASE_ADMIN_URL=
# 実行ロールのパスワード。入っていれば migrate が役割に入れる（migration の直書き値は開発の既定）
KANAME_APP_DB_PASSWORD=
KANAME_AUTH_DB_PASSWORD=
# 認証（Better Auth・schema auth・境界 B2）
AUTH_DATABASE_URL=postgres://kaname_auth:kaname_auth@127.0.0.1:55433/kaname_dev
AUTH_SECRET=change-me-32-chars-minimum-000000000000
# ストレージ（S3 互換 API だけ。supabase-js の storage クライアントは使わない）
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=ap-northeast-1
STORAGE_BUCKET=kaname-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
# 秘密（関門 C8）。base64 で 32 バイト以上
SECRETS_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# 資格情報の預かり先 Infisical（D-101）。staging／本番は必須（起動時に入れるか確かめる）。ローカルは空（メモリに置く＝再起動で消える）。
# 値は Infisical の Machine Identity（Universal Auth）。Vercel の環境変数（Sensitive）にだけ入れる。地域が EU なら https://eu.infisical.com
INFISICAL_SITE_URL=https://us.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
# 通知（関門 C6・Resend）。無ければメールは送らない（inapp だけ）
RESEND_API_KEY=
# メールの差出人（Resend で検証した送信ドメイン）。engine-base.com は 2026-09-20 に検証済み
MAIL_FROM=Kaname <noreply@engine-base.com>
# 運営（ENGINE BASE）の連絡先。問い合わせの届け先・運営アカウントのログイン名
OPS_EMAIL=info@engine-base.com
# 返信したときの宛先（D-096.5）。差出人は noreply、返信は問い合わせの窓口へ
MAIL_REPLY_TO=info@engine-base.com
# 運営者の情報（D-096）。メールの署名・画面・特商法表記が同じ値を読む。電話はメールに載せない・住所はまだ持たない
OPERATOR_COMPANY=株式会社ENGINE BASE
OPERATOR_REPRESENTATIVE=高本聖斗
OPERATOR_PHONE=090-1180-5989
OPERATOR_ADDRESS=
# 規約・プライバシーポリシーの文面に入れる値（K-53）。合意の裁判所と、預ける先の事業者（サーバー・メール・秘密の鍵・ファイル）。
# 既定は無い（事実と違う名前を出さない）。空のままだと文面のページは「文面を準備しています」を出す。本番の値は K-85・K-86 で決める
LEGAL_COURT=
LEGAL_HOSTING_PROVIDER=
LEGAL_MAIL_PROVIDER=
LEGAL_SECRETS_PROVIDER=
LEGAL_STORAGE_PROVIDER=
# この接頭辞で始まる宛先には送らない。dev で自動テストが送出先の 1 日の上限を食い潰さないため。
# staging／本番では空のまま（必ず送る）
MAIL_SUPPRESS_PREFIX=qa-
# 作った Bridge のインストーラを手元のフォルダから配る（開発だけ。staging／本番は空にして BRIDGE_RELEASE_BASE の置き場から配る）
BRIDGE_RELEASE_DIR=

# Bridge の配布物（インストーラ）の置き場。Kaname のサーバーから配る（顧客に外のサービスを見せない）。
# 空＝まだ配布していない（画面は「まだ配布していません」と言い、自動更新も見に行かない）
BRIDGE_RELEASE_BASE=

# 画面と口を同じ住所に見せる中継（K-262）。画面の入口が写した本当の IP と国を、この秘密が合うときだけ口が使う。
# 画面と口の両方のプロジェクトに同じ値をサーバーだけの環境変数で入れる（NEXT_PUBLIC にしない）。空なら写した頭を消すだけ。値は K-263 で入れる
KANAME_EDGE_SECRET=
# 確かめの口 GET /api/edge/echo を開く（1 で開く）。staging の確かめ（scripts/ci/staging_edge_check.py）の間だけ。本番には入れない
KANAME_EDGE_ECHO=

# 請求書の画面の支払い条件（K-958）。空なら「請求書払い ・ 月末締め 翌月 1 日に出す ・ 月末払い」
BILLING_TERMS=請求書払い ・ 月末締め 翌月 1 日に出す ・ 月末払い
# 請求書の画面の振込先（K-958）。行を「|」で区切る。空なら画面は「まだ決まっていません」。口座の番号はここに書かない（環境ごとに入れる）
BILLING_PAYEE=
